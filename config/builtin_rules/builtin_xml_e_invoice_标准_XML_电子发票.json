{
  "id": "builtin_xml_e_invoice",
  "rule_name": "标准 XML 电子发票",
  "file_format": "xml",
  "match_keywords": ["电子发票", "发票", "invoice"],
  "extraction_config": {
    "invoice_number": "发票号码[：:]\\s*(\\d+)",
    "invoice_date": "开票日期[：:]\\s*([\\d]{4}年[\\d]{1,2}月[\\d]{1,2}日)",
    "buyer_name": "购\\s*买\\s*方[\\s\\S]*?名\\s*称[：:]\\s*([^\\n\\r]+)",
    "seller_name": "销\\s*售\\s*方[\\s\\S]*?名\\s*称[：:]\\s*([^\\n\\r]+)",
    "amount_without_tax": "合\\s*计[\\s\\S]*?￥?([\\d,]+\\.?\\d*)",
    "tax_amount": "税\\s*额[\\s\\S]*?￥?([\\d,]+\\.?\\d*)",
    "total_amount": "价税合计[\\s\\S]*?￥?([\\d,]+\\.?\\d*)"
  },
  "required_fields": ["invoice_number", "invoice_date", "total_amount"],
  "created_at": "2026-06-17T10:00:00",
  "updated_at": "2026-06-17T10:00:00",
  "is_builtin": true
}
