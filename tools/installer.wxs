<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" 
           Name="AI智能发票识别管理系统" 
           Language="2052" 
           Version="1.0.0" 
           Manufacturer="AI Fapiao Team" 
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           Codepage="UTF-8">
    
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" 
             Description="AI智能发票识别管理系统 安装程序" 
             Comments="AI 智能发票识别管理系统 v1.0.0" />
    
    <MajorUpgrade DowngradeErrorMessage="已安装更高版本，无法降级安装。" />
    <MediaTemplate EmbedCab="yes" />
    
    <Feature Id="ProductFeature" Title="完整安装" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
    
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="AI智能发票识别管理系统">
          <Component Id="MainExecutable" Guid="11111111-1111-1111-1111-111111111111">
            <File Id="MainExe" Source="dist\ai_fapiao\ai_fapiao.exe" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="AI智能发票识别管理系统">
          <Component Id="ApplicationShortcut" Guid="22222222-2222-2222-2222-222222222222">
            <Shortcut Id="ApplicationStartMenuShortcut" 
                      Name="AI智能发票识别管理系统" 
                      Target="[INSTALLFOLDER]ai_fapiao.exe" 
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\AI智能发票识别管理系统" Name="installed" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    
    <ComponentGroup Id="ProductComponents">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
    </ComponentGroup>
    
  </Product>
</Wix>
